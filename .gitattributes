# Normaliza quebras de linha entre Windows e Kali
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binarios (nunca converter)
*.pdf binary
*.docx binary
*.zip binary
*.png binary
*.jpg binary

# Originais (fontes primarias): NUNCA converter quebras de linha. Bytes identicos ao recebido.
**/00_original/** -text
